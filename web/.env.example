# Firebase console > Project settings > Your apps > Web app > SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required for Firebase AI Logic)
# reCAPTCHA Enterprise site key from Firebase console > App Check > Apps
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional: a debug token you registered for localhost (otherwise one is printed in the console)
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud fallback model (leave blank for the SDK default)
VITE_CLOUD_MODEL=
